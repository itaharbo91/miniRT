OBJS		= $(SRCS:$(SRCDIR)/%.c=$(OBJDIR)/%.o)
BONUS_OBJS	= $(BONUS_SRCS:$(BONUSDIR)/%.c=$(OBJDIR)/%.o)
ALL_OBJS	= $(OBJS) $(BONUS_OBJS)

BONUS_FILE	= .bonus

all: $(MLX_LIB) $(NAME)

$(NAME): $(OBJS)
	@echo "Compiling miniRT..."
	@echo "Linking $(NAME)..."
	$(CC) $(CFLAGS) $(OBJS) $(LIBS) -o $(NAME)
	@echo "miniRT compiled successfully!"

$(OBJDIR)/%.o: $(SRCDIR)/%.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) $(INCLUDES) -c $< -o $@

$(OBJDIR)/%.o: $(BONUSDIR)/%.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) $(INCLUDES) -c $< -o $@

$(MLX_LIB):
	@make -C $(LIBDIR)

bonus: $(MLX_LIB) $(BONUS_FILE)

$(BONUS_FILE): $(BONUS_OBJS)
	@echo "Compiling miniRT with bonus..."
	@echo "Linking $(NAME_BONUS) with bonus..."
	$(CC) $(CFLAGS) $(BONUS_OBJS) $(LIBS) -o $(NAME_BONUS)
	@touch $(BONUS_FILE)
	@echo "miniRT with bonus compiled successfully!"

clean:
	@echo "Cleaning object files..."
	@rm -rf $(OBJDIR)
	@rm -f $(BONUS_FILE)
	@make -C $(LIBDIR) clean
	@echo "Clean completed!"

fclean: clean
	@echo "Cleaning..."
	@rm -f $(NAME) $(NAME_BONUS)
	@echo "Full clean completed!"

re: fclean all

re_bonus: fclean bonus

.PHONY: all clean fclean re bonus re_bonus
